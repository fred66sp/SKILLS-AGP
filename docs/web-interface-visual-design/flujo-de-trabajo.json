  "cards": [
    {"dot": "cyan", "title": "Dirección sin rediseño arbitrario", "items": ["El sistema de diseño y la marca existentes delimitan lo que puede cambiar", "La composición responde a la tarea, la audiencia y la densidad de información", "Los recursos gráficos se eligen por función y fidelidad, no por preferencia por SVG"]},
    {"dot": "rose", "title": "La puerta visual no es el build", "items": ["XML válido o código que compila solo demuestra estructura o sintaxis", "El agente inspecciona imágenes renderizadas, no únicamente DOM y medidas", "Los defectos observados requieren corrección y una nueva inspección del resultado"]},
    {"dot": "emerald", "title": "Cierre trazable", "items": ["La validación estructural, funcional y visual se informa por separado", "Cada evidencia identifica tamaño, tema, estado y limitaciones de la captura", "Sin acceso al render se declara validación visual pendiente; no se afirma calidad demostrada"]}
  ]
