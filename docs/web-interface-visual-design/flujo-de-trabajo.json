    {"id": "itera", "from": "corrige", "to": "implementa", "label": "ajuste mínimo", "role": "return", "variant": "dashed"},
    {"id": "sin-render", "from": "render", "to": "pendiente", "label": "sin acceso al render", "variant": "security"},
