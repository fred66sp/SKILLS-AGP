    {"id": "corrige", "lane": "limites", "col": 2, "type": "backend", "label": "Corregir defectos", "sublabel": "ubicación · efecto · ajuste", "tag": "volver a renderizar"},
    {"id": "pendiente", "lane": "limites", "col": 4, "type": "security", "label": "Validación visual pendiente", "sublabel": "sin render o imagen accesible", "tag": "no afirmar lo no visto", "icon": "stop"},
