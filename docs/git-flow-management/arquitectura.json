  "cards": [
    {
      "dot": "cyan",
      "title": "El paquete instalado",
      "items": [
        "SKILL.md es el cuerpo normativo: invariantes, inspección, clasificación, política por defecto, plan y verificación",
        "references/ son nueve documentos que solo se abren cuando la operación concreta los pide",
        "agents/openai.yaml declara «Git Flow seguro» y permite la invocación implícita; assets/ guarda el icono y las dos plantillas, y scripts/verify-branch.sh comprueba ascendencia y contención"
      ]
    },
    {
      "dot": "rose",
      "title": "Las puertas del flujo",
      "items": [
        "La guardia bloquea cualquier trabajo sobre main o develop y propone la rama permitida desde su base",
        "El plan obliga a una confirmación única y no reutilizable, posterior a la revisión del diff",
        "La verificación no acepta prosa: exige estado, SHA, ascendencia y referencias remotas"
      ]
    },
    {
      "dot": "emerald",
      "title": "Lo que la skill no hace",
      "items": [
        "No crea Issues, PR obligatorias, SemVer ni reglas de merge si la política documentada no las exige",
        "No migra un repositorio existente a Git Flow ni borra ramas por el hecho de estar integradas",
        "No reescribe historia, no hace push forzado y no ejecuta nada destructivo sin autorización específica"
      ]
    }
  ]
}
