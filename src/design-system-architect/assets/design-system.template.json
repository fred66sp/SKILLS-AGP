{
  "schema": "design-system.v1",
  "name": "mi-sistema",
  "version": "0.1.0",
  "status": "bootstrap",
  "identity": {
    "purpose": "Describe el producto, su superficie principal y la tarea que el sistema debe sostener.",
    "principles": [
      "La claridad manda sobre la ornamentación.",
      "Cada acento cromático tiene un significado; el color no decora.",
      "Una sola fuente canónica para tokens y componentes."
    ]
  },
  "tokens": {
    "color": {
      "$type": "color",
      "brand": {
        "$description": "Acento de la acción principal.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.06, 0.46, 0.43],
          "hex": "#0f766e"
        }
      },
      "on-brand": {
        "$description": "Texto y iconos sobre el acento.",
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "hex": "#ffffff"
        }
      },
      "surface": {
        "$description": "Superficie de página y controles.",
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "hex": "#ffffff"
        }
      },
      "text": {
        "$description": "Texto principal.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.06, 0.09, 0.16],
          "hex": "#0f172a"
        }
      },
      "border": {
        "$description": "Línea de separación.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.886, 0.91, 0.941],
          "hex": "#e2e8f0"
        }
      }
    },
    "spacing": {
      "$type": "dimension",
      "sm": { "$value": { "value": 8, "unit": "px" } },
      "md": { "$value": { "value": 16, "unit": "px" } },
      "lg": { "$value": { "value": 24, "unit": "px" } }
    },
    "radius": {
      "$type": "dimension",
      "control": { "$value": { "value": 10, "unit": "px" } },
      "panel": { "$value": { "value": 16, "unit": "px" } }
    },
    "typography": {
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": 1.6
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
          "fontSize": "12px",
          "fontWeight": 700,
          "lineHeight": 1.4,
          "letterSpacing": "0.04em"
        }
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "fast": { "$value": { "value": 150, "unit": "ms" } },
        "base": { "$value": { "value": 250, "unit": "ms" } }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": { "$value": [0.2, 0.8, 0.2, 1] }
      }
    }
  },
  "themes": {
    "default": "light",
    "modes": {
      "light": {},
      "dark": {
        "color.surface": "#0a0f1c",
        "color.text": "#e5e7eb",
        "color.border": "#334155"
      }
    }
  },
  "components": {
    "button": {
      "description": "Control de acción.",
      "when": ["La acción principal de una vista."],
      "when_not": ["Navegación entre vistas.", "Más de una acción principal en la misma vista."],
      "variants": {
        "primary": {
          "backgroundColor": "{color.brand}",
          "textColor": "{color.on-brand}",
          "rounded": "{radius.control}",
          "padding": "10px 16px",
          "typography": "{typography.label}"
        }
      },
      "states": ["default", "hover", "focus", "disabled"],
      "example": "<button type=\"button\" style=\"background: var(--ds-color-brand); color: var(--ds-color-on-brand); border: 0; border-radius: var(--ds-radius-control); padding: 10px 16px;\">Guardar</button>"
    }
  },
  "accessibility": {
    "standard": "WCAG 2.2 AA",
    "focusVisible": true,
    "reducedMotion": true,
    "contrast": {
      "text": 4.5,
      "largeText": 3,
      "nonText": 3
    }
  },
  "governance": {
    "mode": "solo",
    "protected": ["identity.*", "tokens.color.*"],
    "configurable": ["tokens.spacing.*"],
    "exceptions": []
  },
  "constraints": {
    "always": [
      "Usa tokens semánticos; no escribas hexadecimales cuando exista un token.",
      "Conserva el foco visible y `prefers-reduced-motion`."
    ],
    "never": [
      "Usa el color como único indicador de estado.",
      "Introduce una identidad nueva dentro de una tarea de implementación."
    ]
  },
  "decisions": [
    {
      "id": "DS-001",
      "decision": "Un solo acento cromático para la acción principal.",
      "rationale": "El color identifica la acción; no se usa como decoración."
    }
  ],
  "omitted": []
}
